{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus"
    },
    "envName": {
      "value": "tax-invoice-fc"
    },
    "containerImage": {
      "value": "ghcr.io/samuel-ricardo/tax-invoice-issuer-fc:main"
    },
    "postgresAdminUser": {
      "value": "pgadmin"
    },
    "keyVaultId": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/{SUBSCRIPTION_ID}/resourceGroups/{RESOURCE_GROUP}/providers/Microsoft.KeyVault/vaults/{KEY_VAULT_NAME}"
        },
        "secretName": "placeholder"
      },
      "value": null
    },
    "postgresPasswordSecretName": {
      "value": "postgres-password"
    },
    "databaseName": {
      "value": "invoicesdb"
    }
  }
}
